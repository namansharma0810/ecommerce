 <%- layout("layout/boilerplate.ejs") %>

<div class="add-product-page">
    <div class="add-product-card">
        <div class="form-heading">
            <div class="heading-icon">
                <i class="bi bi-box-seam"></i>
            </div>
            <h2>Add New Product</h2>
            <p>Fill in the details below to add a product to your store.</p>
        </div>

        <form action="/products" method="post">
            <div class="mb-4">
                <label for="name" class="form-label">Product name</label>
                <input
                    type="text"
                    class="form-control"
                    id="name"
                    name="name"
                    placeholder="Enter product name"
                    required
                >
            </div>

            <div class="mb-4">
                <label for="image" class="form-label">Product image URL</label>
                <input
                    type="url"
                    class="form-control"
                    id="image"
                    name="image"
                    placeholder="https://example.com/image.jpg"
                    required
                >
                <div class="form-text">Paste a direct link to your product image.</div>
            </div>

            <div class="mb-4">
                <label for="price" class="form-label">Product price (₹)</label>
                <div class="input-group">
                    <span class="input-group-text">₹</span>
                    <input
                        type="number"
                        class="form-control"
                        id="price"
                        name="price"
                        placeholder="0.00"
                        min="0"
                        step="0.01"
                        required
                    >
                </div>
            </div>

            <div class="mb-4">
                <label for="desc" class="form-label">Product description</label>
                <textarea
                    class="form-control"
                    id="desc"
                    name="desc"
                    rows="4"
                    placeholder="Describe your product..."
                    required
                ></textarea>
            </div>

            <div class="form-actions">
                <a href="/products" class="btn btn-cancel">Cancel</a>
                <button type="submit" class="btn btn-add-product">
                    <i class="bi bi-plus-lg"></i>
                    Add Product
                </button>
            </div>
        </form>
    </div>
</div>

<style>
    .add-product-page {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 16px;
        background: #f8fafc;
    }

    .add-product-card {
        width: 100%;
        max-width: 650px;
        padding: 36px;
        background: #fff;
        border: 1px solid #e8edf3;
        border-radius: 20px;
        box-shadow: 0 12px 35px rgba(15, 23, 42, 0.07);
    }

    .form-heading {
        text-align: center;
        margin-bottom: 32px;
    }

    .heading-icon {
        width: 58px;
        height: 58px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 16px;
        border-radius: 16px;
        background: #eaf2ff;
        color: #2563eb;
        font-size: 26px;
    }

    .form-heading h2 {
        color: #172033;
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .form-heading p {
        color: #718096;
        margin: 0;
        font-size: 14px;
    }

    .add-product-card .form-label {
        color: #334155;
        font-weight: 600;
        font-size: 14px;
        margin-bottom: 8px;
    }

    .add-product-card .form-control {
        min-height: 48px;
        padding: 12px 14px;
        border: 1px solid #dbe2ea;
        border-radius: 10px;
        font-size: 14px;
        box-shadow: none;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

    .add-product-card textarea.form-control {
        min-height: 120px;
        resize: vertical;
    }

    .add-product-card .form-control:focus {
        border-color: #3b82f6;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.12);
    }

    .add-product-card .input-group-text {
        background: #f8fafc;
        border-color: #dbe2ea;
        border-radius: 10px 0 0 10px;
        color: #475569;
        font-weight: 600;
    }

    .add-product-card .input-group .form-control {
        border-radius: 0 10px 10px 0;
    }

    .add-product-card .form-text {
        color: #94a3b8;
        font-size: 12px;
        margin-top: 7px;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 30px;
    }

    .form-actions .btn {
        padding: 12px 20px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 14px;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .btn-cancel {
        color: #475569;
        background: #fff;
        border: 1px solid #dbe2ea;
    }

    .btn-cancel:hover {
        background: #f1f5f9;
        color: #172033;
    }

    .btn-add-product {
        color: #fff;
        background: #2563eb;
        border: 1px solid #2563eb;
    }

    .btn-add-product:hover {
        background: #1d4ed8;
        border-color: #1d4ed8;
        color: #fff;
        transform: translateY(-1px);
    }

    @media (max-width: 576px) {
        .add-product-card {
            padding: 24px 18px;
        }

        .form-heading h2 {
            font-size: 24px;
        }

        .form-actions {
            flex-direction: column-reverse;
        }

        .form-actions .btn {
            width: 100%;
            text-align: center;
        }
    }
</style>
<%- include('./partials/footer.ejs') %>